generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   BigInt                  @id @default(autoincrement())
  name                 String
  email                String                  @unique
  phone                String?                 @unique
  role                 String                  @default("patient")
  email_verified_at    DateTime?
  password             String
  profile_completed_at DateTime?
  remember_token       String?
  created_at           DateTime?
  updated_at           DateTime?

  appointments          Appointment[]           @relation("PatientAppointments")
  doctorAppointments    Appointment[]           @relation("DoctorAppointments")
  doctorAvailabilities  DoctorAvailability[]
  doctorLeaveBlocks     DoctorLeaveBlock[]
  prescriptions         Prescription[]          @relation("PatientPrescriptions")
  authoredPrescriptions Prescription[]          @relation("DoctorPrescriptions")
  clinicalExaminations  ClinicalExamination[]   @relation("PatientExaminations")
  performedExaminations ClinicalExamination[]   @relation("OptometristExaminations")
  appointmentNotes      AppointmentNote[]       @relation("AuthoredNotes")
  digitalIntakes        DigitalIntake[]
  labOrders             LabOrder[]              @relation("PatientLabOrders")
  assignedLabOrders     LabOrder[]              @relation("OpticianLabOrders")
  tryOnReservations     TryOnReservation[]
  queueTickets          QueueTicket[]
  invoices              Invoice[]               @relation("PatientInvoices")
  createdInvoices       Invoice[]               @relation("StaffCreatedInvoices")
  approvedRefunds       Invoice[]               @relation("StaffApprovedRefunds")
  hmoClaims             HmoClaim[]
  recallAlerts          RecallAlert[]
  auditLogs             AuditLog[]

  @@map("users")
}

model ClinicService {
  id               BigInt         @id @default(autoincrement())
  name             String
  slug             String         @unique
  category         String         @default("clinical")
  duration_minutes Int            @default(30)
  fee              Decimal        @default(0.00) @db.Decimal(10, 2)
  description      String?
  is_active        Boolean        @default(true)
  created_at       DateTime?
  updated_at       DateTime?

  appointments     Appointment[]
  queueTickets     QueueTicket[]

  @@map("clinic_services")
}

model DoctorAvailability {
  id           BigInt    @id @default(autoincrement())
  doctor_id    BigInt
  doctor       User      @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  starts_at    DateTime
  ends_at      DateTime
  is_available Boolean   @default(true)
  created_at   DateTime?
  updated_at   DateTime?

  @@index([doctor_id, starts_at, is_available])
  @@map("doctor_availabilities")
}

model DoctorLeaveBlock {
  id         BigInt    @id @default(autoincrement())
  doctor_id  BigInt
  doctor     User      @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  starts_at  DateTime
  ends_at    DateTime
  reason     String?
  created_at DateTime?
  updated_at DateTime?

  @@index([doctor_id, starts_at, ends_at])
  @@map("doctor_leave_blocks")
}

model Appointment {
  id               BigInt             @id @default(autoincrement())
  user_id          BigInt
  user             User               @relation("PatientAppointments", fields: [user_id], references: [id], onDelete: Cascade)
  doctor_id        BigInt?
  doctor           User?              @relation("DoctorAppointments", fields: [doctor_id], references: [id], onDelete: SetNull)
  service_id       BigInt?
  clinicService    ClinicService?     @relation(fields: [service_id], references: [id], onDelete: SetNull)
  service          String
  specialist       String?
  exam_room        String?
  starts_at        DateTime
  duration_minutes Int                @default(30)
  notes            String?
  reason           String?
  status           String             @default("requested")
  checked_in_at    DateTime?
  check_in_token   String?
  created_at       DateTime?
  updated_at       DateTime?

  appointmentNotes     AppointmentNote[]
  digitalIntakes       DigitalIntake[]
  clinicalExaminations ClinicalExamination[]
  queueTickets         QueueTicket[]
  invoices             Invoice[]

  @@index([starts_at, status])
  @@index([doctor_id, starts_at, status])
  @@map("appointments")
}

model AppointmentNote {
  id             BigInt      @id @default(autoincrement())
  appointment_id BigInt
  appointment    Appointment @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  author_id      BigInt
  author         User        @relation("AuthoredNotes", fields: [author_id], references: [id], onDelete: Cascade)
  body           String
  created_at     DateTime?
  updated_at     DateTime?

  @@map("appointment_notes")
}

model DigitalIntake {
  id                  BigInt       @id @default(autoincrement())
  appointment_id      BigInt?
  appointment         Appointment? @relation(fields: [appointment_id], references: [id], onDelete: SetNull)
  patient_id          BigInt
  patient             User         @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  medical_history     String?
  symptoms            String?
  ocular_history      String?
  current_medications String?
  allergies           String?
  hmo_provider_name   String?
  hmo_member_id       String?
  preferred_eyewear   String?
  submitted_at        DateTime?
  created_at          DateTime?
  updated_at          DateTime?

  @@index([patient_id, submitted_at])
  @@map("digital_intakes")
}

model ClinicalExamination {
  id                      BigInt        @id @default(autoincrement())
  patient_id              BigInt
  patient                 User          @relation("PatientExaminations", fields: [patient_id], references: [id], onDelete: Cascade)
  optometrist_id          BigInt
  optometrist             User          @relation("OptometristExaminations", fields: [optometrist_id], references: [id], onDelete: Cascade)
  appointment_id          BigInt?
  appointment             Appointment?  @relation(fields: [appointment_id], references: [id], onDelete: SetNull)
  chief_complaint         String?
  visual_acuity_od        String?
  visual_acuity_os        String?
  sph_od                  Decimal?      @db.Decimal(5, 2)
  cyl_od                  Decimal?      @db.Decimal(5, 2)
  axis_od                 Int?
  add_od                  Decimal?      @db.Decimal(4, 2)
  sph_os                  Decimal?      @db.Decimal(5, 2)
  cyl_os                  Decimal?      @db.Decimal(5, 2)
  axis_os                 Int?
  add_os                  Decimal?      @db.Decimal(4, 2)
  pd                      Decimal?      @db.Decimal(5, 2)
  iop_od                  Decimal?      @db.Decimal(5, 2)
  iop_os                  Decimal?      @db.Decimal(5, 2)
  slit_lamp_notes         String?
  fundus_notes            String?
  diagnosis               String?
  management_plan         String?
  digital_signature_token String?
  signed_at               DateTime?
  created_at              DateTime?
  updated_at              DateTime?

  prescriptions Prescription[]

  @@index([patient_id, created_at])
  @@index([optometrist_id, created_at])
  @@map("clinical_examinations")
}

model Prescription {
  id              BigInt               @id @default(autoincrement())
  user_id         BigInt
  user            User                 @relation("PatientPrescriptions", fields: [user_id], references: [id], onDelete: Cascade)
  examination_id  BigInt?
  examination     ClinicalExamination? @relation(fields: [examination_id], references: [id], onDelete: SetNull)
  doctor_id       BigInt?
  doctor          User?                @relation("DoctorPrescriptions", fields: [doctor_id], references: [id], onDelete: SetNull)
  eye             String
  rx_type         String               @default("spectacle")
  sphere          Decimal?             @db.Decimal(5, 2)
  cylinder        Decimal?             @db.Decimal(5, 2)
  axis            Int?
  pd              Decimal?             @db.Decimal(5, 2)
  add             Decimal?             @db.Decimal(4, 2)
  notes           String?
  signature_token String?
  is_verified     Boolean              @default(true)
  issued_at       DateTime             @db.Date
  expires_at      DateTime?            @db.Date
  created_at      DateTime?
  updated_at      DateTime?

  labOrders LabOrder[]

  @@index([user_id, issued_at])
  @@map("prescriptions")
}

model Frame {
  id                BigInt    @id @default(autoincrement())
  sku               String    @unique
  brand             String
  model_name        String
  category          String    @default("spectacle")
  shape             String    @default("rectangular")
  material          String    @default("acetate")
  color             String    @default("black")
  gender            String    @default("unisex")
  eye_size          Int       @default(52)
  bridge_size       Int       @default(18)
  temple_length     Int       @default(140)
  retail_price      Decimal   @default(0.00) @db.Decimal(10, 2)
  cost_price        Decimal?  @db.Decimal(10, 2)
  stock_quantity    Int       @default(0)
  reorder_threshold Int       @default(5)
  supplier_name     String?
  is_consignment    Boolean   @default(false)
  image_url         String?
  is_active         Boolean   @default(true)
  created_at        DateTime?
  updated_at        DateTime?

  labOrders         LabOrder[]
  tryOnReservations TryOnReservation[]

  @@index([brand, category, is_active])
  @@index([shape, material, gender])
  @@map("frames")
}

model LensCatalog {
  id         BigInt    @id @default(autoincrement())
  name       String
  index      String    @default("1.56")
  type       String    @default("single_vision")
  coating    String    @default("anti-reflective")
  price      Decimal   @default(0.00) @db.Decimal(10, 2)
  is_active  Boolean   @default(true)
  created_at DateTime?
  updated_at DateTime?

  labOrders LabOrder[]

  @@map("lens_catalogs")
}

model LabOrder {
  id                        BigInt       @id @default(autoincrement())
  order_number              String       @unique
  patient_id                BigInt
  patient                   User         @relation("PatientLabOrders", fields: [patient_id], references: [id], onDelete: Cascade)
  prescription_id           BigInt?
  prescription              Prescription? @relation(fields: [prescription_id], references: [id], onDelete: SetNull)
  frame_id                  BigInt?
  frame                     Frame?       @relation(fields: [frame_id], references: [id], onDelete: SetNull)
  lens_catalog_id           BigInt?
  lensCatalog               LensCatalog? @relation(fields: [lens_catalog_id], references: [id], onDelete: SetNull)
  optician_id               BigInt?
  optician                  User?        @relation("OpticianLabOrders", fields: [optician_id], references: [id], onDelete: SetNull)
  lab_vendor                String       @default("In-House Edging")
  status                    String       @default("ordered")
  estimated_completion_date DateTime?    @db.Date
  completed_at              DateTime?
  lab_notes                 String?
  created_at                DateTime?
  updated_at                DateTime?

  invoices Invoice[]

  @@index([patient_id, status])
  @@map("lab_orders")
}

model TryOnReservation {
  id             BigInt    @id @default(autoincrement())
  patient_id     BigInt
  patient        User      @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  frame_id       BigInt
  frame          Frame     @relation(fields: [frame_id], references: [id], onDelete: Cascade)
  status         String    @default("reserved")
  reserved_until DateTime
  notes          String?
  created_at     DateTime?
  updated_at     DateTime?

  @@index([patient_id, status])
  @@map("try_on_reservations")
}

model QueueTicket {
  id             BigInt         @id @default(autoincrement())
  ticket_number  String         @unique
  appointment_id BigInt?
  appointment    Appointment?   @relation(fields: [appointment_id], references: [id], onDelete: SetNull)
  patient_id     BigInt?
  patient        User?          @relation(fields: [patient_id], references: [id], onDelete: SetNull)
  patient_name   String
  service_id     BigInt?
  clinicService  ClinicService? @relation(fields: [service_id], references: [id], onDelete: SetNull)
  assigned_room  String?
  status         String         @default("waiting")
  check_in_time  DateTime       @default(now())
  called_at      DateTime?
  completed_at   DateTime?
  created_at     DateTime?
  updated_at     DateTime?

  @@index([status, check_in_time])
  @@map("queue_tickets")
}

model HmoProvider {
  id             BigInt      @id @default(autoincrement())
  name           String
  code           String      @unique
  contact_email  String?
  contact_phone  String?
  coverage_terms String?
  is_active      Boolean     @default(true)
  created_at     DateTime?
  updated_at     DateTime?

  invoices  Invoice[]
  hmoClaims HmoClaim[]

  @@map("hmo_providers")
}

model Invoice {
  id                     BigInt       @id @default(autoincrement())
  invoice_number         String       @unique
  patient_id             BigInt
  patient                User         @relation("PatientInvoices", fields: [patient_id], references: [id], onDelete: Cascade)
  appointment_id         BigInt?
  appointment            Appointment? @relation(fields: [appointment_id], references: [id], onDelete: SetNull)
  lab_order_id           BigInt?
  labOrder               LabOrder?    @relation(fields: [lab_order_id], references: [id], onDelete: SetNull)
  hmo_provider_id        BigInt?
  hmoProvider            HmoProvider? @relation(fields: [hmo_provider_id], references: [id], onDelete: SetNull)
  subtotal               Decimal      @default(0.00) @db.Decimal(10, 2)
  discount_amount        Decimal      @default(0.00) @db.Decimal(10, 2)
  hmo_covered_amount     Decimal      @default(0.00) @db.Decimal(10, 2)
  patient_payable_amount Decimal      @default(0.00) @db.Decimal(10, 2)
  total_paid             Decimal      @default(0.00) @db.Decimal(10, 2)
  payment_method         String       @default("cash")
  payment_status         String       @default("unpaid")
  refund_reason          String?
  refund_approved_by     BigInt?
  refundApprover         User?        @relation("StaffApprovedRefunds", fields: [refund_approved_by], references: [id], onDelete: SetNull)
  created_by             BigInt
  creator                User         @relation("StaffCreatedInvoices", fields: [created_by], references: [id], onDelete: Cascade)
  reconciled_at          DateTime?
  created_at             DateTime?
  updated_at             DateTime?

  items     InvoiceItem[]
  hmoClaims HmoClaim[]

  @@index([patient_id, created_at])
  @@map("invoices")
}

model InvoiceItem {
  id          BigInt    @id @default(autoincrement())
  invoice_id  BigInt
  invoice     Invoice   @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  item_type   String    @default("service")
  item_id     BigInt?
  description String
  quantity    Int       @default(1)
  unit_price  Decimal   @default(0.00) @db.Decimal(10, 2)
  line_total  Decimal   @default(0.00) @db.Decimal(10, 2)
  created_at  DateTime?
  updated_at  DateTime?

  @@map("invoice_items")
}

model HmoClaim {
  id               BigInt      @id @default(autoincrement())
  claim_number     String      @unique
  invoice_id       BigInt
  invoice          Invoice     @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  hmo_provider_id  BigInt
  hmoProvider      HmoProvider @relation(fields: [hmo_provider_id], references: [id], onDelete: Cascade)
  patient_id       BigInt
  patient          User        @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  member_id        String
  approval_code    String?
  claimed_amount   Decimal     @default(0.00) @db.Decimal(10, 2)
  approved_amount  Decimal     @default(0.00) @db.Decimal(10, 2)
  status           String      @default("pending")
  rejection_reason String?
  submitted_at     DateTime?
  settled_at       DateTime?
  created_at       DateTime?
  updated_at       DateTime?

  @@index([hmo_provider_id, status])
  @@map("hmo_claims")
}

model RecallAlert {
  id               BigInt    @id @default(autoincrement())
  patient_id       BigInt
  patient          User      @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  recall_type      String    @default("annual_exam")
  due_date         DateTime  @db.Date
  status           String    @default("pending")
  last_notified_at DateTime?
  notes            String?
  created_at       DateTime?
  updated_at       DateTime?

  @@index([patient_id, due_date, status])
  @@map("recall_alerts")
}

model AuditLog {
  id           BigInt    @id @default(autoincrement())
  actor_id     BigInt?
  actor        User?     @relation(fields: [actor_id], references: [id], onDelete: SetNull)
  action       String
  subject_type String
  subject_id   BigInt
  created_at   DateTime  @default(now())

  @@index([subject_type, subject_id])
  @@map("audit_logs")
}
